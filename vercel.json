{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "**/*.php"
    }
  },
  "routes": [
    { "src": "^/$", "dest": "/api/index.php" },
    { "src": "^/(.*\\.php)$", "dest": "/api/index.php" },
    { "handle": "filesystem" },
    { "src": "^/(.*)$", "dest": "/api/index.php" }
  ]
}
