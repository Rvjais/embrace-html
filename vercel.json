{
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.6.2",
      "config": {
        "includeFiles": ["**/*.php"]
      }
    }
  ],
  "routes": [
    { "src": "/(.*\\.php)$", "dest": "/api/index.php" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
