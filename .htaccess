<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Strip trailing slashes, but never from a real directory. Section hubs are
    # served by <section>/index.php and canonicalised WITH the slash (/blog/,
    # /locations/, /resources/), because nginx — the actual production server —
    # 301s /<section> to /<section>/ whenever the directory exists. Stripping the
    # slash here would fight that redirect and loop.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [L,R=301]

    # Handle Front Controller / Clean PHP URLs: /about -> about.php.
    #
    # The !-d guard matters. A request for /blog must reach the blog/ directory
    # and its index.php, not a same-named .php file at the root; blog.php is only
    # a 301 stub for the retired /blog.php URL and must never serve the hub.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>

DirectoryIndex index.php index.html

# ---------------------------------------------------------------------------
# Compression and caching.
#
# NOTE: embracelives.com is currently served by nginx, which ignores .htaccess
# entirely. These blocks only take effect on Apache. The equivalent nginx
# configuration is in PERFORMANCE.md and has to be applied on the server.
# ---------------------------------------------------------------------------

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    # Asset filenames are content-hashed, so a long life is safe.
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType video/mp4 "access plus 1 year"
    # HTML must stay fresh so content edits appear immediately.
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
