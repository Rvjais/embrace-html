<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect trailing slashes. The second condition covers hub pages such as
    # /blog/, where a blog/ directory of child pages sits beside the blog.php
    # that serves the hub itself; without it that URL keeps its trailing slash
    # and splits from the canonical.
    RewriteCond %{REQUEST_FILENAME} !-d [OR]
    RewriteCond %{DOCUMENT_ROOT}/$1.php -f
    RewriteRule ^(.*)/$ /$1 [L,R=301]

    # Handle Front Controller / Clean PHP URLs.
    #
    # The .php file check runs without a "not a directory" guard on purpose. A
    # hub page like /blog must resolve to blog.php even though a blog/ directory
    # of child articles exists; with the guard in place the directory would win
    # and the hub would fall through to DirectoryIndex, which has no index file.
    # The rule still only fires when the matching .php file genuinely exists, so
    # directories without a same-named page are unaffected.
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>

DirectoryIndex index.php index.html

# ---------------------------------------------------------------------------
# Compression and caching.
#
# NOTE: embracelives.com is currently served by nginx, which ignores .htaccess
# entirely. These blocks only take effect on Apache. The equivalent nginx
# configuration is in PERFORMANCE.md and has to be applied on the server.
# ---------------------------------------------------------------------------

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    # Asset filenames are content-hashed, so a long life is safe.
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType video/mp4 "access plus 1 year"
    # HTML must stay fresh so content edits appear immediately.
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
